{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "Project Template Catalogue Schema",
    "definitions": {
        "SimpleTemplateDescriptor": {
            "type": "object",
            "properties": {
                "@type": {
                    "type": "string"
                },
                "fullyQualifiedName": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "package": {
                    "type": "string",
                    "pattern": "^(?:([A-Za-z_][A-Za-z0-9_]*)(?:\\.[A-Za-z_][A-Za-z0-9_]*)*|https?:\\/\\/\\S+)$"
                },
                "template": {
                    "type": "string"
                },
                "cbindings": {
                    "type": "string"
                },
                "external": {
                    "type": "boolean",
                    "description": "The template belongs to another library (T43): its classes are written under src/external/java of the generated modules, not src/main/java, and its packages are listed in external-packages.txt, so that an application can leave them to that library."
                }
            },
            "required": [
                "@type",
                "fullyQualifiedName",
                "name",
                "template",
                "package",
                "cbindings"
            ],
            "additionalProperties": false
        },
        "CompositeTemplateDescriptor": {
            "type": "object",
            "properties": {
                "@type": {
                    "type": "string"
                },
                "fullyQualifiedName": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "package": {
                    "type": "string"
                },
                "consistsOf": {
                    "type": "string"
                },
                "sharing": {
                    "type": "array",
                    "items": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "external": {
                    "type": "boolean",
                    "description": "The composite belongs to another library (T43): see the same member of a simple template."
                }
            },
            "required": [
                "@type",
                "fullyQualifiedName",
                "name",
                "package",
                "consistsOf",
                "sharing"
            ],
            "additionalProperties": false
        },
        "SubtypeTemplateDescriptor": {
            "description": "EXPERIMENTAL (T36, T41, may change without notice). T36: a subtype of a simple template: its records are that template's records, with some inputs fixed and some in-JSON values carried. It adds nothing to the server side.",
            "type": "object",
            "properties": {
                "@type": {
                    "type": "string"
                },
                "fullyQualifiedName": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "package": {
                    "type": "string"
                },
                "refines": {
                    "description": "The fully qualified name of the simple template this refines.",
                    "type": "string"
                },
                "fixed": {
                    "description": "Inputs of that template given a constant for every record of the subtype, by variable name.",
                    "type": "object",
                    "additionalProperties": {
                        "type": ["string", "number", "boolean"]
                    }
                },
                "carries": {
                    "description": "The in-JSON values of that template this subtype has, each required or optional.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string",
                        "enum": ["required", "optional"]
                    }
                }
            },
            "required": [
                "@type",
                "fullyQualifiedName",
                "name",
                "package",
                "refines"
            ],
            "additionalProperties": false
        },
        "FlowTemplateDescriptor": {
            "description": "EXPERIMENTAL (T36, T41, may change without notice). T36 part E: the flow that connects the beans of a request (the user subtype `from`) to the beans of the backend's record (the subtype `to`): every input of each is accounted for exactly once, with one of six kinds. It adds nothing to the server side.",
            "type": "object",
            "properties": {
                "@type": { "type": "string" },
                "fullyQualifiedName": { "type": "string" },
                "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "package": { "type": "string" },
                "from": { "description": "The fully qualified name of the user subtype the flow starts from.", "type": "string" },
                "to": { "description": "The fully qualified name of the backend subtype the flow ends in.", "type": "string" },
                "stood": {
                    "description": "Each thing that stood before, by a name: node (the backend's input node), madeBy (the output node of the record that made it), addressed (the user bean's node that must be it), identity ({user, backend}), of (the subtype of that record).",
                    "type": "object",
                    "additionalProperties": { "type": "object" }
                },
                "ask": { "description": "The user bean's own values: each {supplied: rule} or {constant: value}.", "type": "object" },
                "record": { "description": "The backend's inputs not carried: asked, absent, {asked, as}, {carried: thing.value}, {constant}, {supplied}; for a map of other keys also {spread: userValue} (T45).", "type": "object" },
                "carry": { "description": "Per stood thing, the values carried over unchanged: a list of names, or \"rest\" (for at most one thing).", "type": "object" },
                "carryOpen": { "description": "Per carrier of the backend's bean, the stood thing whose other keys are carried.", "type": "object", "additionalProperties": { "type": "string" } },
                "reply": { "description": "For answer, refused and failed: how each value of the reply is given.", "type": "object" }
            },
            "required": [ "@type", "fullyQualifiedName", "name", "package", "from", "to" ],
            "additionalProperties": false
        },
        "TemplateDescriptor": {
            "anyOf": [
                {
                    "$ref": "#/definitions/SimpleTemplateDescriptor"
                },
                {
                    "$ref": "#/definitions/CompositeTemplateDescriptor"
                },
                {
                    "$ref": "#/definitions/SubtypeTemplateDescriptor"
                },
                {
                    "$ref": "#/definitions/FlowTemplateDescriptor"
                }
            ]
        },
        "PropertiesDescriptor": {
            "type": "array",
            "items": [
                {
                    "type": "string"
                }
            ]
        },
        "InterfaceDeclaration": {
            "oneOf": [
                {
                    "$ref": "#/definitions/PropertiesDescriptor"
                },
                {
                    "type": "object",
                    "properties": {
                        "variables": {
                            "$ref": "#/definitions/PropertiesDescriptor"
                        },
                        "roles": {
                            "$ref": "#/definitions/PropertiesDescriptor"
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "TableDescriptor": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "serial": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "created_at"
            ],
            "additionalProperties": false
        },
        "GeneratorDescriptor": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "class": {
                    "type": "string"
                },
                "parameters": {
                    "type": "object"
                },
                "classpath": {
                    "type": "array",
                    "items": [
                        {
                            "type": "string"
                        }
                    ]
                }
            },
            "required": [
                "class"
            ],
            "additionalProperties": false
        }
    },
    "type": "object",
    "properties": {
        "group": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "destination": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "version": {
            "type": "string"
        },
        "root_package": {
            "type": "string"
        },
        "script": {
            "type": "string"
        },
        "script_dir": {
            "type": "string"
        },
        "python_dir": {
            "type": "string"
        },
        "javascript_dir": {
            "type": "string"
        },
        "rust_dir": {
            "type": "string"
        },
        "integrator": {
            "type": "boolean"
        },
        "jsweet": {
            "type": "boolean"
        },
        "jsonschema": {
            "type": "string"
        },
        "turtle": {
            "description": "EXPERIMENTAL (T36, T41, may change without notice). T36: the Turtle file describing the subtypes and the in-JSON values of the catalogue's templates; needs turtleNamespace.",
            "type": "string"
        },
        "turtleNamespace": {
            "description": "EXPERIMENTAL (T36, T41, may change without notice). T36: the namespace (an IRI) of the terms of the Turtle file.",
            "type": "string"
        },
        "documentation": {
            "type": "string"
        },
        "variableCheck": {
            "type": "string"
        },
        "privacy": {"type": "string", "description": "T31: path of the application's privacy policy file"},
        "sqlFile": {
            "type": "string"
        },
        "templates": {
            "type": "array",
            "items": [
                {
                    "$ref": "#/definitions/TemplateDescriptor"
                }
            ]
        },
        "interfaces": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/InterfaceDeclaration"
            }
        },
        "search": {
            "type": "array",
            "items": [
                {
                    "type": "string"
                }
            ]
        },
        "sql.tables": {
            "type": "object",
            "patternProperties": {
                "^(.*)$": {
                    "$ref": "#/definitions/TableDescriptor"
                }
            }
        },
        "past-generators": {
            "type": "object",
            "patternProperties": {
                "^(.*)$": {
                    "$ref": "#/definitions/GeneratorDescriptor"
                }
            }
        }
    },
    "required": [
        "group",
        "name",
        "destination",
        "description",
        "version",
        "root_package",
        "script",
        "script_dir",
        "jsweet",
        "jsonschema",
        "documentation",

        "templates"
    ],
    "additionalProperties": false
}