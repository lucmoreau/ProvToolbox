{
  "template": "t31.Approval",
  "comment": "T31 test configurations. Each case adds members to approval-base.json (annotations), may build on another case (base), may change the catalogue (catalogue) and may give the catalogue a privacy policy (policy) and may add a composite of the template, sharing some of its variables (composite), generated by the whole pipeline. 'expect' is what the ruled design says the compiler does; T31CasesTest generates each case and asserts it.",
  "cases": [
    {
      "id": "A0",
      "title": "no annotation",
      "annotations": {},
      "expect": {
        "baseline": true,
        "noClientCheck": true
      }
    },
    {
      "id": "A1",
      "title": "@transient true (default method pt:drop)",
      "annotations": {
        "approver_name": {
          "@transient": true
        }
      },
      "expect": {
        "absentFrom": {
          "approver_name": [
            "store",
            "log",
            "expansion"
          ]
        },
        "keptIn": {
          "approver_name": [
            "bean",
            "schema",
            "doc"
          ]
        },
        "emptyColumn": {
          "approver_name": "pt:drop"
        }
      }
    },
    {
      "id": "A2",
      "title": "@transient pt:local-log",
      "annotations": {
        "approver_name": {
          "@transient": "pt:local-log"
        }
      },
      "expect": {
        "absentFrom": {
          "approver_name": [
            "store",
            "expansion"
          ]
        },
        "keptIn": {
          "approver_name": [
            "bean",
            "log",
            "schema",
            "doc"
          ]
        },
        "emptyColumn": {
          "approver_name": "pt:local-log"
        }
      }
    },
    {
      "id": "A3",
      "title": "@pseudonym erp-ref, unprefixed",
      "annotations": {
        "approver_ref": {
          "@pseudonym": "erp-ref"
        }
      },
      "expect": {
        "constraint": {
          "approver_ref": "pt:erp-ref"
        },
        "privacyConstant": [
          "approver_ref=pt:erp-ref"
        ],
        "noSqlFunction": true,
        "clientCheck": {
          "approver_ref": "Pseudonyms.check"
        },
        "schemaPattern": [
          "approver_ref"
        ],
        "refused": [
          "Jane Smith",
          "jane.smith@example.org",
          ""
        ],
        "accepted": [
          "hr:person/4711",
          null
        ],
        "noWarning": true
      }
    },
    {
      "id": "A4",
      "title": "@pseudonym pt:inline-refs",
      "annotations": {
        "order_note": {
          "@pseudonym": "pt:inline-refs"
        }
      },
      "expect": {
        "constraint": {
          "order_note": "pt:inline-refs"
        },
        "privacyConstant": [
          "order_note=pt:inline-refs"
        ],
        "noSqlFunction": true,
        "clientCheck": {
          "order_note": "Pseudonyms.check"
        },
        "refused": [
          "see ⟨person Jane Smith⟩",
          "unbalanced ⟨person hr:person/1"
        ],
        "accepted": [
          "approved by ⟨person hr:person/4711⟩ on Monday",
          "no person"
        ],
        "knownLimit": "a name in the free text around references is accepted"
      }
    },
    {
      "id": "A5",
      "title": "@pseudonym pt:keyed-hash",
      "annotations": {
        "customer_hash": {
          "@pseudonym": "pt:keyed-hash"
        }
      },
      "expect": {
        "constraint": {
          "customer_hash": "pt:keyed-hash"
        },
        "privacyConstant": [
          "customer_hash=pt:keyed-hash"
        ],
        "noSqlFunction": true,
        "clientCheck": {
          "customer_hash": "Pseudonyms.check"
        },
        "refused": [
          "ACME Ltd",
          "3f2a",
          "k1:3F2A"
        ],
        "accepted": [
          "k1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        ]
      }
    },
    {
      "id": "A6",
      "title": "the library: A1 + A3 + A4 + A5",
      "annotations": {
        "approver_name": {
          "@transient": true
        },
        "approver_ref": {
          "@pseudonym": "pt:erp-ref"
        },
        "order_note": {
          "@pseudonym": "pt:inline-refs"
        },
        "customer_hash": {
          "@pseudonym": "pt:keyed-hash"
        }
      },
      "expect": {
        "union": [
          "A1",
          "A3",
          "A4",
          "A5"
        ],
        "register": 4
      }
    },
    {
      "id": "A7",
      "title": "@transient false",
      "annotations": {
        "approver_name": {
          "@transient": false
        }
      },
      "expect": {
        "sameAs": "A0"
      }
    },
    {
      "id": "P1",
      "title": "A6, application ignores everything",
      "base": "A6",
      "policy": {
        "overrides": {
          "*": {
            "decision": "ignore",
            "reason": "fixtures only"
          }
        }
      },
      "expect": {
        "sameAs": "A0",
        "newFiles": [
          "privacy-register.json",
          "privacy-register.html"
        ],
        "register": 4
      }
    },
    {
      "id": "P2",
      "title": "A6, application overrides pt:erp-ref's implementation",
      "base": "A6",
      "policy": {
        "methods": {
          "pt:erp-ref": {
            "kind": "pseudonym",
            "pattern": "^hr:person/[0-9]+$",
            "resolver": "hr"
          }
        }
      },
      "expect": {
        "like": "A6",
        "constraintPattern": {
          "approver_ref": "^hr:person/[0-9]+$"
        },
        "digestDiffersFrom": "A6",
        "refused": [
          "smith:john"
        ],
        "accepted": [
          "hr:person/4711"
        ],
        "registerDefinedBy": {
          "approver_ref": "policy"
        }
      }
    },
    {
      "id": "P3",
      "title": "A2, application replaces pt:local-log by pt:drop",
      "base": "A2",
      "policy": {
        "overrides": {
          "method:pt:local-log": {
            "@transient": "pt:drop",
            "reason": "our CSV logs are shipped"
          }
        }
      },
      "expect": {
        "sameGeneratedAs": "A1",
        "registerDecidedBy": {
          "approver_name": "method:pt:local-log"
        }
      }
    },
    {
      "id": "P4",
      "title": "A0, application adds a pseudonym the library did not declare",
      "base": "A0",
      "policy": {
        "overrides": {
          "variable:t31.Approval#approver_ref": {
            "@pseudonym": "pt:erp-ref",
            "reason": "references only"
          }
        }
      },
      "expect": {
        "sameGeneratedAs": "A3",
        "registerDeclared": {
          "approver_ref": null
        }
      }
    },
    {
      "id": "P5",
      "title": "A6, application ignores the template",
      "base": "A6",
      "policy": {
        "overrides": {
          "template:t31.Approval": {
            "decision": "ignore",
            "reason": "test template"
          }
        }
      },
      "expect": {
        "sameAs": "A0",
        "register": 4
      }
    },
    {
      "id": "P6",
      "title": "A6, application method replaces a library method on one variable",
      "base": "A6",
      "policy": {
        "methods": {
          "acme:staff-no": {
            "kind": "pseudonym",
            "pattern": "^S[0-9]{6}$",
            "resolver": "hr"
          }
        },
        "overrides": {
          "variable:t31.Approval#approver_ref": {
            "@pseudonym": "acme:staff-no",
            "reason": "staff numbers"
          }
        }
      },
      "expect": {
        "constraint": {
          "approver_ref": "acme:staff-no"
        },
        "constraintPattern": {
          "approver_ref": "^S[0-9]{6}$"
        },
        "refused": [
          "hr:person/4711"
        ],
        "accepted": [
          "S004711"
        ]
      }
    },
    {
      "id": "P7",
      "title": "A6, application lifts @transient on one variable",
      "base": "A6",
      "policy": {
        "overrides": {
          "variable:t31.Approval#approver_name": {
            "decision": "ignore",
            "reason": "not personal here"
          }
        }
      },
      "expect": {
        "union": [
          "A3",
          "A4",
          "A5"
        ]
      }
    },
    {
      "id": "P8",
      "title": "A1, application changes the default transient method",
      "base": "A1",
      "policy": {
        "methods": {
          "acme:keep-log": {
            "kind": "transient",
            "keeps": [
              "log"
            ]
          }
        },
        "overrides": {
          "method:pt:drop": {
            "@transient": "acme:keep-log",
            "reason": "local logs kept"
          }
        }
      },
      "expect": {
        "sameGeneratedAs": "A2",
        "renaming": {
          "acme:keep-log": "pt:local-log"
        }
      }
    },
    {
      "id": "E1",
      "title": "both annotations on one variable",
      "annotations": {
        "approver_name": {
          "@transient": true,
          "@pseudonym": "pt:erp-ref"
        }
      },
      "expect": {
        "error": "R11 both",
        "errorContains": "both @transient and @pseudonym"
      }
    },
    {
      "id": "E2",
      "title": "@transient on a name variable (identifier position)",
      "annotations": {
        "approver": {
          "@transient": true
        }
      },
      "expect": {
        "error": "R11 name variable",
        "errorContains": "name variable"
      }
    },
    {
      "id": "E3",
      "title": "@transient on an @output variable",
      "annotations": {
        "approving": {
          "@transient": true
        }
      },
      "expect": {
        "error": "R11 output",
        "errorContains": "only for an input"
      }
    },
    {
      "id": "E4",
      "title": "@transient with @unique",
      "annotations": {
        "approver_name": {
          "@transient": true,
          "@unique": true
        }
      },
      "expect": {
        "error": "R11 unique",
        "errorContains": "@unique"
      }
    },
    {
      "id": "E5",
      "title": "@pseudonym on an input with @sql.table (allowed: an input's value lands in the template's own column)",
      "annotations": {
        "order": {
          "@pseudonym": "pt:erp-ref"
        }
      },
      "expect": {
        "constraint": {
          "order": "pt:erp-ref"
        }
      }
    },
    {
      "id": "E6",
      "title": "unknown pseudonym method",
      "annotations": {
        "approver_ref": {
          "@pseudonym": "pt:no-such"
        }
      },
      "expect": {
        "error": "R11 unknown method",
        "errorContains": "unknown method"
      }
    },
    {
      "id": "E7",
      "title": "unknown transient method",
      "annotations": {
        "approver_name": {
          "@transient": "pt:no-such"
        }
      },
      "expect": {
        "error": "R11 unknown method",
        "errorContains": "unknown method"
      }
    },
    {
      "id": "E8",
      "title": "application method undefined",
      "annotations": {
        "approver_ref": {
          "@pseudonym": "acme:staff-no"
        }
      },
      "expect": {
        "error": "R11 unknown method",
        "errorContains": "unknown method"
      }
    },
    {
      "id": "E9",
      "title": "E8 rescued: the application ignores the annotation",
      "base": "E8",
      "policy": {
        "overrides": {
          "method:acme:staff-no": {
            "decision": "ignore",
            "reason": "not deployed"
          }
        }
      },
      "expect": {
        "sameAs": "A0"
      }
    },
    {
      "id": "E10",
      "title": "the application invents a pt: method",
      "base": "A0",
      "policy": {
        "methods": {
          "pt:new-thing": {
            "kind": "pseudonym",
            "pattern": "^x$"
          }
        }
      },
      "expect": {
        "error": "R3",
        "errorContains": "reserved for ProvToolbox"
      }
    },
    {
      "id": "E11",
      "title": "a decision without a reason",
      "base": "A6",
      "policy": {
        "overrides": {
          "*": {
            "decision": "ignore"
          }
        }
      },
      "expect": {
        "error": "R11 reason",
        "errorContains": "needs a reason"
      }
    },
    {
      "id": "E12",
      "title": "a scope naming an unknown variable",
      "base": "A6",
      "policy": {
        "overrides": {
          "variable:t31.Approval#nobody": {
            "decision": "ignore",
            "reason": "typo"
          }
        }
      },
      "expect": {
        "error": "R11 scope",
        "errorContains": "unknown variable"
      }
    },
    {
      "id": "E13",
      "title": "a pseudonym method with neither pattern, sql nor class",
      "base": "A0",
      "policy": {
        "methods": {
          "acme:empty": {
            "kind": "pseudonym"
          }
        }
      },
      "expect": {
        "error": "R11 definition",
        "errorContains": "needs a pattern"
      }
    },
    {
      "id": "E14",
      "title": "a transient method keeping an unknown place",
      "base": "A0",
      "policy": {
        "methods": {
          "acme:x": {
            "kind": "transient",
            "keeps": [
              "cloud"
            ]
          }
        }
      },
      "expect": {
        "error": "R11 place",
        "errorContains": "unknown place"
      }
    },
    {
      "id": "E15",
      "title": "@pseudonym on a variable that is not an input (@input false)",
      "annotations": {
        "customer_hash": {
          "@input": "false",
          "@pseudonym": "pt:keyed-hash"
        }
      },
      "expect": {
        "error": "R11 inputs only",
        "errorContains": "only for an input"
      }
    },
    {
      "id": "E16",
      "title": "@pseudonym on an input that may be an output (@output optional)",
      "annotations": {
        "approver_ref": {
          "@output": "optional",
          "@pseudonym": "pt:erp-ref"
        }
      },
      "expect": {
        "error": "R11 inputs only",
        "errorContains": "only for an input"
      }
    },
    {
      "id": "E17",
      "title": "a policy adding @pseudonym to an output",
      "base": "A0",
      "policy": {
        "overrides": {
          "variable:t31.Approval#approving": {
            "@pseudonym": "pt:erp-ref",
            "reason": "mistake"
          }
        }
      },
      "expect": {
        "error": "R11 inputs only",
        "errorContains": "only for an input"
      }
    },
    {
      "id": "P9",
      "title": "A6, an application method with its own PAST method for the languages generated",
      "base": "A6",
      "policy": {
        "methods": {
          "acme:staff-no": {
            "kind": "pseudonym",
            "pattern": "^S[0-9]{6}$",
            "past": {
              "package": "com.acme.privacy",
              "class": "Checks",
              "method": "staffNo"
            },
            "targets": [
              "java",
              "python"
            ]
          }
        },
        "overrides": {
          "variable:t31.Approval#approver_ref": {
            "@pseudonym": "acme:staff-no",
            "reason": "staff numbers"
          }
        }
      },
      "expect": {
        "clientCheck": {
          "approver_ref": "com.acme.privacy.Checks.staffNo"
        },
        "constraintPattern": {
          "approver_ref": "^S[0-9]{6}$"
        },
        "registerNote": {
          "approver_ref": "client check defined in application code"
        }
      }
    },
    {
      "id": "R1",
      "title": "a pseudonym in a catalogue that generates Rust: the Rust client leaves the check out, with a warning (Ruling 7)",
      "base": "A3",
      "catalogue": {
        "rust_dir": "rust"
      },
      "expect": {
        "warning": [
          "approver_ref, method pt:erp-ref: the generated Rust client doesn't check this pseudonym"
        ],
        "notInRust": [
          "approver_ref"
        ],
        "clientCheck": {
          "approver_ref": "org.openprovenance.prov.utils.Pseudonyms.check"
        },
        "constraint": {
          "approver_ref": "pt:erp-ref"
        },
        "registerNote": {
          "approver_ref": "not checked by the generated Rust client (Ruling 7)"
        }
      }
    },
    {
      "id": "R2",
      "title": "the library (A6) in a catalogue that generates Rust: transient values handled as in the other languages, pseudonym checks left out of the Rust client with a warning each",
      "base": "A6",
      "catalogue": {
        "rust_dir": "rust"
      },
      "expect": {
        "warning": [
          "approver_ref, method pt:erp-ref",
          "order_note, method pt:inline-refs",
          "customer_hash, method pt:keyed-hash"
        ],
        "notInRust": [
          "approver_ref",
          "order_note",
          "customer_hash"
        ],
        "emptyColumn": {
          "approver_name": "pt:drop"
        },
        "register": 4
      }
    },
    {
      "id": "E19",
      "title": "a custom PAST method not provided for a language the catalogue generates",
      "base": "P9",
      "policy": {
        "methods": {
          "acme:staff-no": {
            "kind": "pseudonym",
            "pattern": "^S[0-9]{6}$",
            "past": {
              "package": "com.acme.privacy",
              "class": "Checks",
              "method": "staffNo"
            },
            "targets": [
              "java"
            ]
          }
        },
        "overrides": {
          "variable:t31.Approval#approver_ref": {
            "@pseudonym": "acme:staff-no",
            "reason": "staff numbers"
          }
        }
      },
      "expect": {
        "error": "R11 targets (R17): python generated, not provided",
        "errorContains": "generates python"
      }
    },
    {
      "id": "C0",
      "base": "A0",
      "title": "A0 with a composite sharing the approval activity",
      "composite": {
        "sharing": [
          "approving"
        ]
      },
      "expect": {
        "composite": {
          "stored": [
            "approver_name",
            "approver_ref",
            "order_note",
            "customer_hash"
          ],
          "notStored": [],
          "noRegister": true
        },
        "noClientCheck": true
      }
    },
    {
      "id": "C1",
      "base": "A6",
      "title": "A6 with a composite sharing the approval activity: the composite inherits the component's annotations",
      "composite": {
        "sharing": [
          "approving"
        ]
      },
      "expect": {
        "composite": {
          "stored": [
            "approver_ref",
            "order_note",
            "customer_hash"
          ],
          "notStored": [
            "approver_name"
          ],
          "registerAs": "A6"
        },
        "emptyColumn": {
          "approver_name": "pt:drop"
        },
        "constraint": {
          "approver_ref": "pt:erp-ref",
          "order_note": "pt:inline-refs",
          "customer_hash": "pt:keyed-hash"
        },
        "register": 4
      }
    },
    {
      "id": "E20",
      "base": "A1",
      "title": "a composite sharing a transient variable",
      "composite": {
        "sharing": [
          "approving",
          "approver_name"
        ]
      },
      "expect": {
        "error": "compile error (R11)",
        "errorContains": "shared by the composite"
      }
    }
  ]
}
