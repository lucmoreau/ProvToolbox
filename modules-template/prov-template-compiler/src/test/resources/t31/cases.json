{
  "template": "t31.Approval",
  "comment": "T31 test configurations. Each case adds members to approval-base.json (annotations) and may give the catalogue a privacy policy. 'expect' is what the design (R1-R15) says the compiler should do; T31BaselineTest records what today's compiler does.",
  "cases": [
    { "id": "A0", "title": "no annotation",
      "annotations": {}, "expect": { "baseline": true } },
    { "id": "A1", "title": "@transient true (default method pt:drop)",
      "annotations": { "approver_name": { "@transient": true } },
      "expect": { "absentFrom": { "approver_name": ["store", "log", "expansion"] }, "keptIn": { "approver_name": ["bean", "schema", "doc"] } } },
    { "id": "A2", "title": "@transient pt:local-log",
      "annotations": { "approver_name": { "@transient": "pt:local-log" } },
      "expect": { "absentFrom": { "approver_name": ["store", "expansion"] }, "keptIn": { "approver_name": ["bean", "log", "schema", "doc"] } } },
    { "id": "A3", "title": "@pseudonym erp-ref, unprefixed",
      "annotations": { "approver_ref": { "@pseudonym": "erp-ref" } },
      "expect": { "constraint": { "approver_ref": "pt:erp-ref" }, "privacyConstant": ["approver_ref=pt:erp-ref"], "noSqlFunction": true, "schemaPattern": ["approver_ref"],
                  "refused": ["Jane Smith", "jane.smith@example.org", ""], "accepted": ["hr:person/4711", null] } },
    { "id": "A4", "title": "@pseudonym pt:inline-refs",
      "annotations": { "order_note": { "@pseudonym": "pt:inline-refs" } },
      "expect": { "constraint": { "order_note": "pt:inline-refs" }, "privacyConstant": ["order_note=pt:inline-refs"], "noSqlFunction": true,
                  "refused": ["see ⟨person Jane Smith⟩", "unbalanced ⟨person hr:person/1"], "accepted": ["approved by ⟨person hr:person/4711⟩ on Monday", "no person"] ,
                  "knownLimit": "a name in the free text around references is accepted" } },
    { "id": "A5", "title": "@pseudonym pt:keyed-hash",
      "annotations": { "customer_hash": { "@pseudonym": "pt:keyed-hash" } },
      "expect": { "constraint": { "customer_hash": "pt:keyed-hash" }, "privacyConstant": ["customer_hash=pt:keyed-hash"], "noSqlFunction": true,
                  "refused": ["ACME Ltd", "3f2a", "k1:3F2A"], "accepted": ["k1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"] } },
    { "id": "A6", "title": "the library: A1 + A3 + A4 + A5",
      "annotations": { "approver_name": { "@transient": true }, "approver_ref": { "@pseudonym": "pt:erp-ref" },
                       "order_note": { "@pseudonym": "pt:inline-refs" }, "customer_hash": { "@pseudonym": "pt:keyed-hash" } },
      "expect": { "union": ["A1", "A3", "A4", "A5"], "register": 4 } },
    { "id": "A7", "title": "@transient false",
      "annotations": { "approver_name": { "@transient": false } },
      "expect": { "sameAs": "A0" } },

    { "id": "P1", "title": "A6, application ignores everything",
      "base": "A6", "policy": { "overrides": { "*": { "decision": "ignore", "reason": "fixtures only" } } },
      "expect": { "sameAs": "A0", "newFiles": ["privacy-register.json", "privacy-register.html"], "register": 4 } },
    { "id": "P2", "title": "A6, application overrides pt:erp-ref's implementation",
      "base": "A6", "policy": { "methods": { "pt:erp-ref": { "kind": "pseudonym", "pattern": "^hr:person/[0-9]+$", "resolver": "hr" } } },
      "expect": { "like": "A6", "constraintPattern": { "approver_ref": "^hr:person/[0-9]+$" }, "digestDiffersFrom": "A6", "refused": ["smith:john"], "accepted": ["hr:person/4711"],
                  "registerDefinedBy": { "approver_ref": "policy" } } },
    { "id": "P3", "title": "A2, application replaces pt:local-log by pt:drop",
      "base": "A2", "policy": { "overrides": { "method:pt:local-log": { "@transient": "pt:drop", "reason": "our CSV logs are shipped" } } },
      "expect": { "sameGeneratedAs": "A1", "registerDecidedBy": { "approver_name": "method:pt:local-log" } } },
    { "id": "P4", "title": "A0, application adds a pseudonym the library did not declare",
      "base": "A0", "policy": { "overrides": { "variable:t31.Approval#approver_ref": { "@pseudonym": "pt:erp-ref", "reason": "references only" } } },
      "expect": { "sameGeneratedAs": "A3", "registerDeclared": { "approver_ref": null } } },
    { "id": "P5", "title": "A6, application ignores the template",
      "base": "A6", "policy": { "overrides": { "template:t31.Approval": { "decision": "ignore", "reason": "test template" } } },
      "expect": { "sameAs": "A0", "register": 4 } },
    { "id": "P6", "title": "A6, application method replaces a library method on one variable",
      "base": "A6", "policy": { "methods": { "acme:staff-no": { "kind": "pseudonym", "pattern": "^S[0-9]{6}$", "resolver": "hr" } },
                                "overrides": { "variable:t31.Approval#approver_ref": { "@pseudonym": "acme:staff-no", "reason": "staff numbers" } } },
      "expect": { "constraint": { "approver_ref": "acme:staff-no" }, "constraintPattern": { "approver_ref": "^S[0-9]{6}$" }, "refused": ["hr:person/4711"], "accepted": ["S004711"] } },
    { "id": "P7", "title": "A6, application lifts @transient on one variable",
      "base": "A6", "policy": { "overrides": { "variable:t31.Approval#approver_name": { "decision": "ignore", "reason": "not personal here" } } },
      "expect": { "union": ["A3", "A4", "A5"] } },
    { "id": "P8", "title": "A1, application changes the default transient method",
      "base": "A1", "policy": { "methods": { "acme:keep-log": { "kind": "transient", "keeps": ["log"] } },
                                "overrides": { "method:pt:drop": { "@transient": "acme:keep-log", "reason": "local logs kept" } } },
      "expect": { "sameGeneratedAs": "A2" } },

    { "id": "E1", "title": "both annotations on one variable",
      "annotations": { "approver_name": { "@transient": true, "@pseudonym": "pt:erp-ref" } }, "expect": { "error": "R11 both" } },
    { "id": "E2", "title": "@transient on a name variable (identifier position)",
      "annotations": { "approver": { "@transient": true } }, "expect": { "error": "R11 name variable" } },
    { "id": "E3", "title": "@transient on an @output variable",
      "annotations": { "approving": { "@transient": true } }, "expect": { "error": "R11 output" } },
    { "id": "E4", "title": "@transient with @unique",
      "annotations": { "approver_name": { "@transient": true, "@unique": true } }, "expect": { "error": "R11 unique" } },
    { "id": "E5", "title": "@pseudonym on an input with @sql.table (allowed: an input's value lands in the template's own column)",
      "annotations": { "order": { "@pseudonym": "pt:erp-ref" } }, "expect": { "constraint": { "order": "pt:erp-ref" } } },
    { "id": "E6", "title": "unknown pseudonym method",
      "annotations": { "approver_ref": { "@pseudonym": "pt:no-such" } }, "expect": { "error": "R11 unknown method" } },
    { "id": "E7", "title": "unknown transient method",
      "annotations": { "approver_name": { "@transient": "pt:no-such" } }, "expect": { "error": "R11 unknown method" } },
    { "id": "E8", "title": "application method undefined",
      "annotations": { "approver_ref": { "@pseudonym": "acme:staff-no" } }, "expect": { "error": "R11 unknown method" } },
    { "id": "E9", "title": "E8 rescued: the application ignores the annotation",
      "base": "E8", "policy": { "overrides": { "method:acme:staff-no": { "decision": "ignore", "reason": "not deployed" } } },
      "expect": { "sameAs": "A0" } },
    { "id": "E10", "title": "the application invents a pt: method",
      "base": "A0", "policy": { "methods": { "pt:new-thing": { "kind": "pseudonym", "pattern": "^x$" } } }, "expect": { "error": "R3" } },
    { "id": "E11", "title": "a decision without a reason",
      "base": "A6", "policy": { "overrides": { "*": { "decision": "ignore" } } }, "expect": { "error": "R11 reason" } },
    { "id": "E12", "title": "a scope naming an unknown variable",
      "base": "A6", "policy": { "overrides": { "variable:t31.Approval#nobody": { "decision": "ignore", "reason": "typo" } } }, "expect": { "error": "R11 scope" } },
    { "id": "E13", "title": "a pseudonym method with neither pattern, sql nor class",
      "base": "A0", "policy": { "methods": { "acme:empty": { "kind": "pseudonym" } } }, "expect": { "error": "R11 definition" } },
    { "id": "E14", "title": "a transient method keeping an unknown place",
      "base": "A0", "policy": { "methods": { "acme:x": { "kind": "transient", "keeps": ["cloud"] } } }, "expect": { "error": "R11 place" } },
    { "id": "E15", "title": "@pseudonym on a variable that is not an input (@input false)",
      "annotations": { "customer_hash": { "@input": "false", "@pseudonym": "pt:keyed-hash" } }, "expect": { "error": "R11 inputs only" } },
    { "id": "E16", "title": "@pseudonym on an input that may be an output (@output optional)",
      "annotations": { "approver_ref": { "@output": "optional", "@pseudonym": "pt:erp-ref" } }, "expect": { "error": "R11 inputs only" } },
    { "id": "E17", "title": "a policy adding @pseudonym to an output",
      "base": "A0", "policy": { "overrides": { "variable:t31.Approval#approving": { "@pseudonym": "pt:erp-ref", "reason": "mistake" } } },
      "expect": { "error": "R11 inputs only" } }
  ]
}
