{
  "description": "T36: conformance vectors of the JSON text runtime (Java: org.openprovenance.prov.utils.JsonText). Every port (Java, the jsweet candy, Python) reads each 'input' as JSON, with read(), and writes it back with write(): the answer must be exactly 'output'. A 'refused' input must be refused by read(). The members of an object are written in the order they were read; numbers follow RFC 8785; no integer beyond 2^53 is used, since JavaScript cannot tell it from its neighbours.",
  "canonical": [
    {"title": "empty object", "input": "{}", "output": "{}"},
    {"title": "blank text is the empty object", "input": "", "output": "{}"},
    {"title": "white space is dropped", "input": " { \"a\" : [ 1 , 2.5 , true , null ] } ", "output": "{\"a\":[1,2.5,true,null]}"},
    {"title": "order of the members is kept", "input": "{\"b\":1,\"a\":2,\"c\":{\"z\":1,\"y\":2}}", "output": "{\"b\":1,\"a\":2,\"c\":{\"z\":1,\"y\":2}}"},
    {"title": "a repeated key keeps its first place and its last value", "input": "{\"a\":1,\"b\":2,\"a\":3}", "output": "{\"a\":3,\"b\":2}"},
    {"title": "an integer", "input": "{\"x\":100}", "output": "{\"x\":100}"},
    {"title": "a negative integer", "input": "{\"x\":-7}", "output": "{\"x\":-7}"},
    {"title": "a double with no fraction is written as an integer", "input": "{\"x\":1.0}", "output": "{\"x\":1}"},
    {"title": "5.0", "input": "{\"x\":5.0}", "output": "{\"x\":5}"},
    {"title": "negative zero", "input": "{\"x\":-0.0}", "output": "{\"x\":0}"},
    {"title": "a fraction", "input": "{\"x\":4.35}", "output": "{\"x\":4.35}"},
    {"title": "0.1", "input": "{\"x\":0.1}", "output": "{\"x\":0.1}"},
    {"title": "0.1 + 0.2", "input": "{\"x\":0.30000000000000004}", "output": "{\"x\":0.30000000000000004}"},
    {"title": "a small number written in full", "input": "{\"x\":0.000001}", "output": "{\"x\":0.000001}"},
    {"title": "a smaller number in exponent form", "input": "{\"x\":1E-7}", "output": "{\"x\":1e-7}"},
    {"title": "a mantissa and a negative exponent", "input": "{\"x\":2.5e-10}", "output": "{\"x\":2.5e-10}"},
    {"title": "a large number written in full", "input": "{\"x\":123456789012345680000}", "output": "{\"x\":123456789012345680000}"},
    {"title": "the first number written with an exponent", "input": "{\"x\":1e21}", "output": "{\"x\":1e+21}"},
    {"title": "a large mantissa and exponent", "input": "{\"x\":1.5e300}", "output": "{\"x\":1.5e+300}"},
    {"title": "an exponent on an integer", "input": "{\"x\":12e2}", "output": "{\"x\":1200}"},
    {"title": "booleans and null", "input": "{\"t\":true,\"f\":false,\"n\":null}", "output": "{\"t\":true,\"f\":false,\"n\":null}"},
    {"title": "a quote and a backslash are escaped, a solidus is not", "input": "{\"s\":\"a\\\"b\\\\c\\/d\"}", "output": "{\"s\":\"a\\\"b\\\\c/d\"}"},
    {"title": "the short escapes", "input": "{\"s\":\"\\b\\f\\n\\r\\t\"}", "output": "{\"s\":\"\\b\\f\\n\\r\\t\"}"},
    {"title": "other control characters are written as \\u00xx, in lower case", "input": "{\"s\":\"\\u0001\\u001f\\u000b\"}", "output": "{\"s\":\"\\u0001\\u001f\\u000b\"}"},
    {"title": "a letter written as an escape is written as the letter", "input": "{\"s\":\"\\u0041\\u00e9\"}", "output": "{\"s\":\"Aé\"}"},
    {"title": "the line separator is not escaped", "input": "{\"s\":\"\\u2028\"}", "output": "{\"s\":\"\u2028\"}"},
    {"title": "a surrogate pair is written as the character", "input": "{\"s\":\"\\ud83d\\ude00\"}", "output": "{\"s\":\"\ud83d\ude00\"}"},
    {"title": "an escaped key", "input": "{\"k\\\"ey\":1}", "output": "{\"k\\\"ey\":1}"},
    {"title": "nested lists and objects", "input": "{\"a\":[[1,[2]],{\"b\":[]}],\"c\":{}}", "output": "{\"a\":[[1,[2]],{\"b\":[]}],\"c\":{}}"}
  ],
  "refused": [
    {"title": "a list is not an object", "input": "[1]"},
    {"title": "a number is not an object", "input": "1"},
    {"title": "unterminated object", "input": "{"},
    {"title": "no value", "input": "{\"a\":}"},
    {"title": "a trailing comma", "input": "{\"a\":1,}"},
    {"title": "an unquoted key", "input": "{a:1}"},
    {"title": "a leading zero", "input": "{\"a\":01}"},
    {"title": "text after the object", "input": "{\"a\":1} x"},
    {"title": "a bad escape", "input": "{\"a\":\"\\x\"}"},
    {"title": "a short unicode escape", "input": "{\"a\":\"\\u12\"}"},
    {"title": "NaN is no JSON", "input": "{\"a\":NaN}"},
    {"title": "a raw control character in a string", "input": "{\"a\":\"\t\"}"},
    {"title": "a fraction with no digit", "input": "{\"a\":1.}"},
    {"title": "an exponent with no digit", "input": "{\"a\":1e}"}
  ],
  "getters": [
    {"title": "an int", "input": "{\"k\":3}", "key": "k", "method": "getInteger", "result": 3},
    {"title": "an int from a double with no fraction", "input": "{\"k\":3.0}", "key": "k", "method": "getInteger", "result": 3},
    {"title": "absent", "input": "{}", "key": "k", "method": "getInteger", "result": null},
    {"title": "null is absent", "input": "{\"k\":null}", "key": "k", "method": "getString", "result": null},
    {"title": "a fraction is no int", "input": "{\"k\":3.5}", "key": "k", "method": "getInteger", "refused": true},
    {"title": "a string is no int", "input": "{\"k\":\"3\"}", "key": "k", "method": "getInteger", "refused": true},
    {"title": "an int too large for an int", "input": "{\"k\":4294967296}", "key": "k", "method": "getInteger", "refused": true},
    {"title": "a long", "input": "{\"k\":4294967296}", "key": "k", "method": "getLong", "result": 4294967296},
    {"title": "a double", "input": "{\"k\":2.5}", "key": "k", "method": "getDouble", "result": 2.5},
    {"title": "a double from an integer", "input": "{\"k\":2}", "key": "k", "method": "getDouble", "result": 2},
    {"title": "a boolean", "input": "{\"k\":true}", "key": "k", "method": "getBoolean", "result": true},
    {"title": "a string is no boolean", "input": "{\"k\":\"true\"}", "key": "k", "method": "getBoolean", "refused": true},
    {"title": "a string", "input": "{\"k\":\"x\"}", "key": "k", "method": "getString", "result": "x"},
    {"title": "a number is no string", "input": "{\"k\":1}", "key": "k", "method": "getString", "refused": true},
    {"title": "a nested value as its text", "input": "{\"k\":{ \"a\" : [1, 2.0] }}", "key": "k", "method": "getJson", "result": "{\"a\":[1,2]}"}
  ]
}
