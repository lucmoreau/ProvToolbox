{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {

        "Context": {
            "$id": "#/definitions/Context",
            "type": "object",
            "title": "The Items Schema",
            "additionalProperties": { "type": "string"}
        },
        "QualifiedName": {
            "$id": "#/definitions/QualifiedName",
            "type": "string",
            "title": "The QualifiedName Schema",
            "default": "",
            "pattern": "^[A-Za-z0-9_]+:(.*)$"
        },
        "XsdType": {
            "$id": "#/definitions/XsdType",
            "type": "string",
            "enum": ["xsd:string", "xsd:int", "xsd:long", "xsd:float", "xsd:double", "xsd:boolean", "xsd:dateTime", "xsd:date", "json"]
        },

        "lang_string": {
            "type": "object",
            "required": [ "@value" ],
            "properties": {
                "@value": {
                    "type": "string"
                },
                "@language": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "ValuesOrIds": {
            "oneOf": [
                {
                    "$ref": "#/definitions/ArrayOfArraysOfValues"
                },
                {
                    "$ref": "#/definitions/ArrayOfIds"
                },
                {
                    "type": "null"
                }
            ]
        },
        "ArrayOfArraysOfValues": {
            "type": "array",
            "items": [
                { "$ref": "#/definitions/ArrayOfValues" }
            ]
        },
        "ArrayOfValues": {
            "$id": "#/definitions/ArrayOfValues",
            "type": "array",
            "items": {
                "anyOf": [
                    { "$ref": "#/definitions/An@value" },
                    { "$ref": "#/definitions/An@id" },
                    { "$ref": "#/definitions/QualifiedName" },
                    { "$ref": "#/definitions/lang_string" }
                ]
            }
        },
        "ArrayOfIds": {
            "$id": "#/definitions/ArrayOfIds",
            "type": "array",
            "items": {
                "anyOf": [
                    { "$ref": "#/definitions/An@id" }
                ]
            }
        },

        "An@id":  {
            "type": "object",
            "properties": {
                "@id": {
                    "type": "string"
                },
                "@type": {"$ref": "#/definitions/XsdType"},

                "@documentation": {
                    "type": "string"
                },
                "@examplar": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ]
                },
                "@input": {
                    "type": "string",
                    "enum": ["compulsory", "optional", "false"]
                },
                "@output": {
                    "type": "string",
                    "enum": ["true", "optional", "false"]
                },
                "@sql.table": {
                    "type": "string"
                },
                "@sql.type": {
                    "description": "The SQL type of the column that holds the value.",
                    "type": "string"
                },
                "@escape": {
                    "description": "true: the value is escaped (a text that may hold the CSV separator); read as a text.",
                    "oneOf": [ { "type": "boolean" }, { "type": "string" } ]
                },
                "@role": {
                    "description": "The role of this node in the template, for uniform accessors: getCause, getEffect, getGeneral and the same with 2.",
                    "type": "string",
                    "enum": ["cause", "effect", "general", "cause2", "effect2", "general2"]
                },
                "@semantic.type": {
                    "description": "Marks the node as a semantic type of the template (the compiler reads it as a text, \"true\").",
                    "oneOf": [ { "type": "boolean" }, { "type": "string" } ]
                },
                "@sql.new.inputs": {
                    "description": "For the SQL function of the template: the inputs the function adds, name to SQL type.",
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                },
                "@sql.also.outputs": {
                    "description": "For the SQL function of the template: the outputs the function also returns, name to SQL type.",
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                },
                "@unique": {
                    "description": "true: the column of the value is unique.",
                    "type": "boolean"
                },
                "@transient": {
                    "description": "The value is never persisted, or kept only where this method says: true for the default method, or a method name.",
                    "oneOf": [ { "type": "boolean" }, { "type": "string" } ]
                },
                "@pseudonym": {
                    "description": "The value arrives pseudonymised, in the form of this method (a name; unprefixed means pt:).",
                    "type": "string"
                }
            },
            "required": [
                "@id"
            ],
            "additionalProperties": false
        },
        "An@value": {
            "type": "object",
            "properties": {
                "@value": {
                    "type": "string"
                },
                "@type": {"$ref": "#/definitions/XsdType"},
                "@documentation": {
                    "type": "string"
                },
                "@examplar": {
                    "description": "An example value: a text, a number (integer or not) or a boolean.",
                    "anyOf": [ { "type": "string" }, { "type": "number" }, { "type": "boolean" } ]
                },
                "@input" : {
                    "type": "string",
                    "enum": ["compulsory", "optional", "false"]
                },
                "@output" : {
                    "type": "string",
                    "enum": ["true", "optional", "false"]
                },
                "@escape": {
                    "description": "true: the value is escaped (a text that may hold the CSV separator); read as a text.",
                    "oneOf": [ { "type": "boolean" }, { "type": "string" } ]
                },
                "@unique": {
                    "description": "true: the column of the value is unique.",
                    "type": "boolean"
                },
                "@transient": {
                    "description": "The value is never persisted, or kept only where this method says: true for the default method, or a method name.",
                    "oneOf": [ { "type": "boolean" }, { "type": "string" } ]
                },
                "@pseudonym": {
                    "description": "The value arrives pseudonymised, in the form of this method (a name; unprefixed means pt:).",
                    "type": "string"
                },
                "@sql.foreign": {
                    "description": "The column refers to another table: type, attribute and item.",
                    "type": "object",
                    "properties": { "type": { "type": "string" }, "attribute": { "type": "string" }, "item": { "type": "string" } },
                    "additionalProperties": false
                },
                "@sql.type" : {
                    "type": "string"
                },
                "@inJson" : {
                    "description": "EXPERIMENTAL (T36, may change without notice). T36: the text variable (a carrier) this value is encoded in, as a key of its JSON object; it is no bean field and no column",
                    "type": "string",
                    "minLength": 1
                },
                "@inJson.key" : {
                    "description": "EXPERIMENTAL (T36, may change without notice). T36: the key in the carrier, when it differs from the variable's name",
                    "type": "string",
                    "minLength": 1
                },
                "@performative" : {
                    "description": "EXPERIMENTAL (T36, may change without notice). T36 part D: whose content the value is: the caller's (request) or the service's (reply). Absent: the service's own. A subtype gets a request and a reply class from it.",
                    "type": "string",
                    "enum": ["request", "reply"]
                }
            },
            "additionalProperties": false
        }

    },
    "type": "object",
    "properties": {
        "var": {
            "type": "object",
            "patternProperties": {
                "^(?![iI][dD]$)[^:\\[\\]()/\\\\,\\-]+$": { "$ref": "#/definitions/ValuesOrIds" }
            }
        },
        "vargen": {
            "type": "object"
        },
        "context": {
            "$ref": "#/definitions/Context"
        },
        "template": {
            "type":  ["string", "null"]
        },
        "@documentation": {
            "type":  ["string", "null"]
        },
        "@return": {
            "description": "What the template compiler's generated logger method returns, as a text: the javadoc line of its @return. Absent: not documented.",
            "type":  ["string", "null"]
        }
    },
    "required": [
        "var",
        "context"
    ],
    "additionalProperties": false
}
