{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Schema for a Template Transformation File",
    "definitions": {
        "SchemaCheck": {
            "description": "The version of the PROV-JSONLD schema a generated jsonld output is validated against: none (no check, the default when absent), default (the version ProvToolbox writes), or a date naming a version bundled with ProvToolbox (2024-08-25, 2026-09-12, 2026-10-14). A -qn suffix (default-qn, 2026-10-14-qn) selects the strict variant, which also enforces the syntax of a qualified name (PROV-N, ASCII).",
            "type": "string",
            "pattern": "^(none|default(-qn)?|[0-9]{4}-[0-9]{2}-[0-9]{2}(-qn)?)$"
        },
        "ProvFormat": {
            "type": "string",
            "enum": ["provn", "prov-jsonld", "jsonld","svg", "png", "pdf", "qualified.png", "qualified.svg", "qualified.pdf",
                     "qualified-inv.png", "qualified-inv.svg", "qualified-inv.pdf", "mmd", "qualified.mmd"]
        },
        "InstantiateTask": {
            "type": "object",
            "properties": {
                "type": { "const": "instantiate" },
                "description": { "type": "string" },
                "template": { "type": "string" },
                "bindings": { "type": "string" },
                "output": { "type": "string" },
                "outputFullyQualifiedName": { "type": "string" },
                "formats": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/ProvFormat" }
                },

                "hasProvenance": {
                    "type": "string"
                },
                "addOutputDirToInputPath": {
                    "type": "boolean"
                },
                "copyinput": {
                    "type": "boolean"
                },
                "clean2": {
                    "type": "boolean"
                },
                "template_path": {
                    "type": "array",
                    "items": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                },
                "variableCheck": {
                    "type": "string"
                },
                "schemaCheck": {
                    "$ref": "#/definitions/SchemaCheck"
                }
            },
            "required": ["type", "template", "bindings", "output", "formats"],
            "additionalProperties": false
        },
        "MergeTask": {
            "type": "object",
            "properties": {
                "type": { "const": "merge" },
                "description": { "type": "string" },
                "inputs": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1
                },
                "output": { "type": "string" },
                "outputFullyQualifiedName": { "type": "string" },
                "formats": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/ProvFormat" }
                },

                "hasProvenance": {
                    "type": "string"
                },
                "addOutputDirToInputPath": {
                    "type": "boolean"
                },
                "copyinput": {
                    "type": "boolean"
                },
                "clean2": {
                    "type": "boolean"
                },
                "template_path": {
                    "type": "array",
                    "items": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                },
                "variableCheck": {
                    "type": "string"
                },
                "schemaCheck": {
                    "$ref": "#/definitions/SchemaCheck"
                }
            },
            "required": ["type", "inputs", "output", "formats"],
            "additionalProperties": false
        }
    },
    "type": "object",
    "properties": {
        "template_path": {
            "type": "array",
            "items": [
                {
                    "type": "string"
                }
            ],
            "minItems": 1
        },
        "bindings_path": {
            "type": "array",
            "items": [
                {
                    "type": "string"
                }
            ],
            "minItems": 1
        },
        "output_dir": {
            "type": "string"
        },
        "schemaCheck": {
            "$ref": "#/definitions/SchemaCheck"
        },
        "variableMaps": {
            "type": "array",
            "items": [
                {
                    "type": "string"
                }
            ]
        },
        "tasks": {
            "type": "array",
            "items": {
                "oneOf": [
                    { "$ref": "#/definitions/InstantiateTask" },
                    { "$ref": "#/definitions/MergeTask" }
                ]
            },
            "minItems": 1
        }
    },

    "required": [
        "template_path",
        "bindings_path",
        "output_dir",
        "variableMaps",
        "tasks"
    ]
}