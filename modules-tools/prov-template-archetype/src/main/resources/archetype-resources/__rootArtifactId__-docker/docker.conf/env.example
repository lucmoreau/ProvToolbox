# Configuration of the template service containers.
#
# Copy this file to docker.conf/.env (git-ignored), fill it in, and keep it
# readable only by you (chmod 600 docker.conf/.env). Never commit .env.
# make config.check tells you what is still missing for each security mode.
# See ../README.md for an explanation of every value.

# --- service --------------------------------------------------------------
# keycloak, github or none (none: every endpoint open, for local trials only)
TPL_SECURITY_MODE=keycloak
# port of this machine on which the service listens
TPL_HTTP_PORT=8080
# URL at which browsers reach the service, without the context ${serviceContext}
TPL_PUBLIC_URL=http://localhost:8080
# image to run; empty: the image make image builds for this machine
# (${rootArtifactId}-docker.temurin on amd64, ${rootArtifactId}-docker.temurin-mac on arm64)
TPL_IMAGE=

# --- database (postgres16 container) --------------------------------------
# superuser of the postgres container, used once to create the service's database
POSTGRES_PASSWORD=
# account the service uses, created on the first start of an empty database
TPL_DB_USER=
TPL_DB_PASS=

# --- keycloak mode ----------------------------------------------------------
# e.g. https://keycloak.example.org/auth (Keycloak's base URL, before /realms)
KEYCLOAK_BASE_URI=
KEYCLOAK_REALM=
# public client for browser login (standard flow); its valid redirect URIs
# must include TPL_PUBLIC_URL${serviceContext}/callback
KEYCLOAK_CLIENT_ID=
# client id(s), comma-separated, whose access tokens are accepted as bearer
# tokens (the token's azp claim)
KEYCLOAK_DIRECT_CLIENT_ID=
# optional: the realm's RSA public key; read from the realm at start-up if empty
KEYCLOAK_SIGNATURE_PUBLIC_KEY=
# role given to the users authenticated by bearer token
KEYCLOAK_ROLE=provwriter

# --- github mode ------------------------------------------------------------
# OAuth App (GitHub > Settings > Developer settings > OAuth Apps) whose
# authorization callback URL is TPL_PUBLIC_URL${serviceContext}/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# who may use the service: comma-separated GitHub logins, github:<numeric id>, or *
GITHUB_ALLOWLIST=
