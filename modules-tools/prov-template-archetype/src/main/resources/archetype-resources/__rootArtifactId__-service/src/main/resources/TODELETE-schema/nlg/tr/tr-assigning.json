{
    "select": { "act": { "@type": "prov:Activity" } },

    "query": [
        "prefix resp <http://openprovenance.org/ns/responsibility#>",
        "select * from der a prov:WasDerivedFrom",
        "from item1 a prov:Entity",
        " join der.generatedEntity = item1.id",
        "from item0 a prov:Entity",
        " join der.usedEntity = item0.id",
        "from act a prov:Activity",
        " join der.activity = act.id",
        "from wat a prov:WasAttributedTo",
        " optional join item1.id = wat.entity",
        "from keeper a prov:Agent",
        " optional join wat.agent = keeper.id",
        "from wgb a prov:WasGeneratedBy",
        " optional join item1.id = wgb.entity",
        "where act[prov:type] >= 'resp:Assigning'"
    ],

    "sentence": {
        "type": "clause",
        "object": {
            "type": "noun_phrase",
            "determiner": "The",
            "head": {
                "type": "@funcall",
                "@object": "item1",
                "@property": "prov:type",
                "@function": "lookup-type-with-default",
                "@arg1": "noun_phrase",
                "@arg2": "item"
            },
            "post-modifiers": [
                {
                    "type": "adjective_phrase",
                    "head": {
                        "type": "@funcall",
                        "@object": "item1",
                        "@field": "id",
                        "@function": "noun+identity",
                        "@arg1": ""
                    }
                }
            ],
            "features": { "number": "singular" }
        },
        "verb": {
            "type": "@funcall",
            "@object": "act",
            "@property": "prov:type",
            "@function": "lookup-type",
            "@arg1": "verb_phrase"
        },
        "modifiers": [
            {
                "type": "preposition_phrase",
                "preposition": "to",
                "noun": {
                    "type": "noun_phrase",
                    "head": {
                        "type": "@funcall",
                        "@object": "keeper",
                        "@property": "prov:type",
                        "@function": "lookup-type-with-default",
                        "@arg1": "noun_phrase",
                        "@arg2": "agent",
                        "@optional": "true"
                    },
                    "post-modifiers": [
                        {
                            "type": "adjective_phrase",
                            "head": {
                                "type": "@funcall",
                                "@object": "keeper",
                                "@field": "id",
                                "@function": "noun+identity",
                                "@arg1": "",
                                "@optional": "true"
                            }
                        }
                    ]
                }
            },
            {
                "type": "preposition_phrase",
                "preposition": "on",
                "noun": {
                    "type": "@funcall",
                    "@object": "wgb",
                    "@field": "time",
                    "@optional": "true",
                    "@function": "friendly_timestring"
                }
            }
        ],
        "features": {
            "tense": "past",
            "passive": "true"
        }
    },

    "context": {
        "trs":     "https://openprovenance.org/transport/ns/#",
        "phys":    "http://openprovenance.org/ns/phys#",
        "resp":    "http://openprovenance.org/ns/responsibility#",
        "provext": "http://openprovenance.org/prov/extension#"
    }
}
