{
    "callbackUrl": "http://localhost:7075/book/callback",
    "configurations": {
        "GitHubClient": {
            "@type": "GitHubClient",
            "clientId": "REPLACE-WITH-GITHUB-OAUTH-APP-CLIENT-ID",
            "clientSecretEnv": "GITHUB_CLIENT_SECRET",
            "callbackUrl": "http://localhost:7075/book/callback",
            "scope": "read:user",
            "allowlist": ["REPLACE-WITH-GITHUB-LOGIN", "github:REPLACE-WITH-GITHUB-NUMERIC-ID"]
        },
        "GitHubBearerAuthClient": {
            "@type": "GitHubBearerAuthClient",
            "cacheTtlSeconds": 300,
            "allowlist": ["REPLACE-WITH-GITHUB-LOGIN", "github:REPLACE-WITH-GITHUB-NUMERIC-ID"]
        }
    }
}
